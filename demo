/* USER CODE BEGIN PFP */
void PMS7003_Parse(uint8_t *data)
{
    if (data[0] == 0x42 && data[1] == 0x4D) // Header
    {
        pm1_0 = (data[10] << 8) | data[11];
        pm2_5 = (data[12] << 8) | data[13];
        pm10  = (data[14] << 8) | data[15];
    }
}
